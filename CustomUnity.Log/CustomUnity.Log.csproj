<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Unity.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>CustomUnity</RootNamespace>
    <AssemblyName>CustomUnity.Log</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>CustomUnity.Log</Product>
    <Version>1.0.0</Version>

    <!--
      These log wrappers only exist as a precompiled plugin so that double-clicking a
      message in Unity's Console jumps to the call site instead of landing here.
      Unity resolves the click target from the first stack frame that carries file and
      line info, which comes from the assembly's debug symbols - so the assembly must
      ship without any. [HideInCallstack] alone is not enough: it only removes the
      frame from the displayed callstack, not from the click target.
      Keep DebugType none, and never place these sources in an .asmdef assembly.
    -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Unity imports whatever lands in Assets, so build to bin\ and copy only the dll. -->
    <UnityPluginDir>$(UnityProjectDir)Assets\CustomUnity\Plugins</UnityPluginDir>
    <RequiresUnityScriptAssemblies>true</RequiresUnityScriptAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CustomUnity.Editor.Log" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule" HintPath="$(UnityManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(UnityManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEditor.CoreModule" HintPath="$(UnityManagedDir)\UnityEditor.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(UnityScriptAssembliesDir)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToUnityPlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityPluginDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="$(AssemblyName).dll -> $(UnityPluginDir)" />
  </Target>

</Project>
